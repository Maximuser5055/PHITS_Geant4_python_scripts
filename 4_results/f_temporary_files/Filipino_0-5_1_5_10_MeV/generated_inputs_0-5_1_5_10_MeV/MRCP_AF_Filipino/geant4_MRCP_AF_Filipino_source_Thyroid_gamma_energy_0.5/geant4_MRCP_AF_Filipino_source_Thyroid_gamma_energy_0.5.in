# Example macro file to run in the batch mode

# Set the verbose
/run/verbose 1

# Set the number of threads for multi-threading mode
/run/numberOfThreads 32

# Initialize
/run/initialize

# source setting
/control/execute geant4_MRCP_AF_Filipino_source_Thyroid_gamma_energy_0.5.mac

# Set the nps
/run/beamOn 500000000
