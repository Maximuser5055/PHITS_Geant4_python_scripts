# Example macro file to run in the batch mode

# Set the verbose
/run/verbose 1

# Set the number of threads for multi-threading mode
/run/numberOfThreads 32

# Initialize
/run/initialize

# source setting
/control/execute geant4_MRCP_AM_Filipino_source_Spleen_gamma_energy_5.0.mac

# Set the nps
/run/beamOn 100000000
