${{PARALLELIZATION}}={{THREADS}}

# ----------------------------------------------------------------------------
#    name               : MRCP PHANTOM                                        
#    sex                : {{SEXINFO}}                                              
#    author             : HUREL
# ----------------------------------------------------------------------------

[ Parameters ]
 icntl    =           0     # (D=0) 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
 maxcas   =  {{MAXCAS}}     # (D=10) number of particles per one batch
 maxbch   =  {{MAXBCH}}     # (D=10) number of batches
 itetvol  =           0     # (D=0) =1 Volume calculation for tetrahedrons
 ntetelem =        2000     # Number of tetra element allowed in sub-block
 maxbnk   =     1000000     # (D=10000) maximum bank memory length
 itetra   =           0     # (D=0) tetra data is read(=1)/write(=2) on binary
 file(6)  = {{PHITSOUTPUTFILE}} # (D=phits.out) general output file name
 file(7)  = {{NUCLEARDATAFILE}} # nuclear data input file name
 file(20) = {{EGS5DIRECTORY}}       # Directory library data for EGS5
 negs     =           1     # (D=-1) 1:EGS
 ipegs    =           0     # [EGS](D=0) 0:Full

[ Source ]
  totfact =    1.00         # (D=1.0) global factor
   s-type =    24            # rectangular-solid source
     proj = {{SOURCETYPE}}        # kind of incident particle 
   tetreg = {{SOURCEREGION}}          # Liver as source
       e0 = {{SOURCEENERGY}}         # energy of beam [MeV/u]
      dir =   all           # z-direction of beam [isotropic]

[ Material ]
$ ----------------------------------------------------------------------------
$ MATERIAL DATA FOR EACH ORGAN/TISSUE
$ ----------------------------------------------------------------------------
infl:{../phantoms/MRCP-{{SEX}}.material}

[ Surface ]
  10  rpp -37.8854 37.8854 -24.56301 24.56301 -98.00236 98.00236  $ Phantom box
  20  rpp -38.0854 38.0854 -24.76301 24.76301 -98.20236 98.20236
  90  box -1000 -1000 -1000 2000 0 0 0 2000 0 0 0 2000         $ World boundary
  
[ Cell ]
$ ----------------------------------------------------------------------------
$ CELLS FOR PHANTOM
$ ----------------------------------------------------------------------------
infl:{../phantoms/MRCP-{{SEX}}.cell}

[ T-deposit ]
# Deposit energy in a certain region.
 file   = {{DEPOSITOUTPUTFILE}}        # file name of output for the axis
 mesh   = reg               # mesh type is region-wise
 reg    = {{TARGETREGIONS}}               # all regions become tallying region
 axis   = reg               # axis of output
 unit   = 0                 # unit is [Gy/source]
        
[ End ]
