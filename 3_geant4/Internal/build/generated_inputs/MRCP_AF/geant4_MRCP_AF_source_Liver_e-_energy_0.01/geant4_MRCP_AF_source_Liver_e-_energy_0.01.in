# Example macro file to run in the batch mode

# Set the verbose
/run/verbose 2

# Set the number of threads for multi-threading mode
/run/numberOfThreads 32

# Initialize
/run/initialize

# source setting
/control/execute geant4_MRCP_AF_source_Liver_e-_energy_0.01.mac

# Set the nps
/run/beamOn 1000
