# Example macro file to run in the batch mode

# Set the verbose
/run/verbose 2

# Set the number of threads for multi-threading mode
/run/numberOfThreads 12

# Initialize
/run/initialize

# source setting
/control/execute Geant4_MRCP_AM_source_Thyroid_electron_energy_10.0.mac

# Set the nps
/run/beamOn 1000
