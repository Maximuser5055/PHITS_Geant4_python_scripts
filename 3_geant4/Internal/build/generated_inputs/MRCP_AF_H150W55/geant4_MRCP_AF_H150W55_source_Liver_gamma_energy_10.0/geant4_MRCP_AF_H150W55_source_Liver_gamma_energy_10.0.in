# Example macro file to run in the batch mode

# Set the verbose
/run/verbose 2

# Set the number of threads for multi-threading mode
/run/numberOfThreads 12

# Initialize
/run/initialize

# source setting
/control/execute geant4_MRCP_AF_H150W55_source_Liver_gamma_energy_10.0.mac

# Set the nps
/run/beamOn 10000
