# Example macro file to run in the batch mode

# Set the verbose
/run/verbose 1

# Set the number of threads for multi-threading mode
/run/numberOfThreads 12

# Initialize
/run/initialize

# source setting
/control/execute geant4_MRCP_AM_source_Cortical_bone_gamma_energy_0.01.mac

# Set the nps
/run/beamOn 1000000000
